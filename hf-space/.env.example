# RAGmind HF Space - environment
# Local: copy to `.env` and fill. Production: set each as a Space Secret
# (Space > Settings > Variables and secrets). NEVER commit the filled .env.

# ── Supabase ──────────────────────────────────────────────────────────────
# Project: Ragmind. All Supabase values live in: Project Settings > API
SUPABASE_URL=https://bvmxlwarcofitbrntizj.supabase.co

# service_role key — SECRET, server-only. Bypasses RLS (trusted writes).
# Dashboard: Project Settings > API > Project API keys > service_role  (click "reveal")
SUPABASE_SERVICE_KEY=

# anon / publishable key (public). Used for RLS-scoped reads with the user JWT.
SUPABASE_ANON_KEY=sb_publishable_C6PmAdg3ejcm2uv_cTNf6Q__oUJ3jWf

# JWT secret — verifies incoming user tokens.
# Dashboard: Project Settings > API > JWT Settings > JWT Secret  (click "reveal")
SUPABASE_JWT_SECRET=

# ── Hugging Face ──────────────────────────────────────────────────────────
# Optional. Needed only for gated/private GGUF downloads. Token: https://huggingface.co/settings/tokens
HF_TOKEN=

# ── LLM (llama-cpp-python) ────────────────────────────────────────────────
LLM_REPO=bartowski/Mistral-7B-Instruct-v0.3-GGUF
LLM_FILE=Mistral-7B-Instruct-v0.3-Q4_K_M.gguf
LLM_N_CTX=8192
LLM_N_GPU_LAYERS=0          # 0 = CPU, -1 = offload all layers to GPU
LLM_MAX_TOKENS=1024
WARM_ON_START=false

# ── Embeddings / reranking ────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVER_K=8
RERANK_K=4
MULTI_QUERY=true

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated frontend origins. Add your deployed frontend URL for production.
ALLOWED_ORIGINS=http://localhost:5173
