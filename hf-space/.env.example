# RAGmind HF Space - environment (set as Space secrets in production)

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY      # trusted writes; never expose to frontend
SUPABASE_ANON_KEY=YOUR_ANON_KEY                 # used for RLS-scoped reads with user JWT
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET             # verifies incoming user tokens

# Hugging Face
HF_TOKEN=                                        # optional; needed for gated/private GGUF

# LLM (llama-cpp-python)
LLM_REPO=bartowski/Mistral-7B-Instruct-v0.3-GGUF
LLM_FILE=Mistral-7B-Instruct-v0.3-Q4_K_M.gguf
LLM_N_CTX=8192
LLM_N_GPU_LAYERS=0          # 0 = CPU, -1 = offload all layers to GPU
LLM_MAX_TOKENS=1024
WARM_ON_START=false

# Embeddings / reranking
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVER_K=8
RERANK_K=4
MULTI_QUERY=true

# CORS (frontend origins, comma-separated)
ALLOWED_ORIGINS=http://localhost:5173
